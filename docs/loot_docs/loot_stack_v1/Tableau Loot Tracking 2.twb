          <datasource-dependencies datasource='federated.0yhhxos1d6jtlj1e6o0yv0kaja8o'>
            <column caption='Modifier Name' datatype='string' name='[Calculation_2121563853889536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='split([modifier_type], &apos;:&apos;, 2)' />
            </column>
            <column aggregation='Sum' caption='Expected Count (GLM)' datatype='real' name='[Calculation_2121563867299852]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL((([set_count_max (modifier_added_leaf_candidates.csv)] + [set_count_min (modifier_added_leaf_candidates.csv)]) / 2), 1)' />
            </column>
            <column caption='is Item Leaf? (GLM)' datatype='boolean' name='[Calculation_2121563870965773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[leaf_kind (modifier_added_leaf_candidates.csv)] = &quot;minecraft:item&quot;' />
            </column>
            <column caption='Path Drop Chance (GLM)' datatype='real' default-format='p0.0%' name='[Calculation_2121563876323342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([path_pool_share_product (modifier_added_leaf_candidates.csv)] * [path_random_chance_product (modifier_added_leaf_candidates.csv)], [path_pool_share_product (modifier_added_leaf_candidates.csv)])' />
