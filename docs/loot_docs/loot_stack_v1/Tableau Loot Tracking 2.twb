              <calculation class='tableau' formula='IFNULL([path_explicit_weight_product], 1)' />
            </column>
            <column caption='path_loot_rarity' datatype='real' name='[Calculation_2021232074440708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2021232073302019] * [Calculation_2021232103333893]' />
