      </connection>
      <aliases enabled='yes' />
      <column caption='Item Path Key' datatype='string' hidden='true' name='[Calculation_2021232337788948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[item_id]&#13;&#10;+ &quot; | &quot; +&#13;&#10;[root_table_id]&#13;&#10;+ &quot; | &quot; +&#13;&#10;STR([root_pool_index])' />
      </column>
      <column caption='Is Item Leaf?' datatype='boolean' name='[Calculation_2021232345575445]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[leaf_kind] = &quot;minecraft:item&quot;' />
      </column>
      <column aggregation='Sum' caption='Path Drop Chance' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_2021232355794966]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ifnull([path_pool_share_product] * [path_random_chance_product], [path_pool_share_product])' />
      </column>
      <column caption='Value Freq Rank' datatype='real' name='[Calculation_2021232380076061]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [item_value]&#13;&#10;    WHEN &quot;common&quot; THEN 1.3&#13;&#10;    WHEN &quot;uncommon&quot; THEN 1.5&#13;&#10;    WHEN &quot;rare&quot; THEN 1&#13;&#10;    WHEN &quot;epic&quot; THEN 1.25&#13;&#10;    WHEN &quot;legendary&quot; THEN .85&#13;&#10;END' />
      </column>
      <column caption='Item Value Freq Rank' datatype='real' name='[Calculation_2021232399499309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Calculation_2021232380076061])' />
      </column>
      <column caption='Item Drop Frequency' datatype='real' name='[Calculation_2021232400007214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([drop_events_expected])' />
      </column>
      <column caption='Item Frequency Ratio' datatype='real' name='[Calculation_2021232400351279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2021232400007214] / [Calculation_2021232399499309] * 2' />
      </column>
      <column caption='Item Namespace' datatype='string' name='[Calculation_2021233130868806]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([item_id], &apos;:&apos;, 1)' />
      </column>
      <column caption='Item Name' datatype='string' name='[Calculation_2021233131151431]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([item_id], &apos;:&apos;, 2)' />
