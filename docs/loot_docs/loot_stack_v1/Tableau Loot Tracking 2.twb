          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0yhhxos1d6jtlj1e6o0yv0kaja8o].[usr:Calculation_2021232400351279:qk]' included-values='non-null' />
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0yhhxos1d6jtlj1e6o0yv0kaja8o].[none:item_id:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0yhhxos1d6jtlj1e6o0yv0kaja8o].[usr:Calculation_2021232400351279:qk]' shelf='rows' />
