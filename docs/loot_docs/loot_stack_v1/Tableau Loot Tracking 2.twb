      </column>
      <column caption='Root Table Name' datatype='string' name='[Calculation_2021233131548745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split(&#13;&#10;  split([root_table_id], &apos;:&apos;, 2),&#13;&#10;  &apos;/&apos;,&#13;&#10;  -1&#13;&#10;)' />
