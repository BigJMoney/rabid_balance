      <aliases enabled='yes' />
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([set_count_min])) - LOOKUP(ZN(SUM([set_count_min])), -1)'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Set Count Average' datatype='real' name='[Calculation_2021231990538241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((([set_count_max] + [set_count_min]) / 2), 1)' />
      </column>
