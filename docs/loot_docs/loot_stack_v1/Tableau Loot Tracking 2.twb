      <aliases enabled='yes' />
      <column aggregation='Sum' caption='Entry Count Expected' datatype='real' name='[Calculation_2021231990538241]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL((([set_count_max] + [set_count_min]) / 2), 1)' />
      </column>
      <column caption='Table Role' datatype='string' name='[Calculation_2021232011026434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [effective_role]=&apos;assumed_direct_for_tableau&apos; or&#13;&#10;   [effective_role]=&apos;direct_from_data&apos;&#13;&#10;  then &apos;direct&apos; &#13;&#10;  else &apos;helper&apos;&#13;&#10;end' />
      </column>
      <column aggregation='Sum' caption='Pool Rolls Expected' datatype='real' name='[Calculation_2021232103333893]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [rolls_kind] = &apos;literal&apos;&#13;&#10;  then [rolls_min]&#13;&#10;else&#13;&#10;  ([rolls_min] + [rolls_max]) / 2&#13;&#10;end' />
      </column>
      <column caption='Item Path Key' datatype='string' hidden='true' name='[Calculation_2021232337788948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[item_id]&#13;&#10;+ &quot; | &quot; +&#13;&#10;[root_table_id]&#13;&#10;+ &quot; | &quot; +&#13;&#10;STR([root_pool_index])' />
      </column>
      <column caption='Is Item Leaf?' datatype='boolean' name='[Calculation_2021232345575445]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[leaf_kind] = &quot;minecraft:item&quot;' />
      </column>
      <column aggregation='Sum' caption='Path Drop Chance' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_2021232355794966]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[path_pool_share_product]' />
      </column>
      <column aggregation='Sum' caption='Drop Yield Expected' datatype='real' name='[Calculation_2021232360861719]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_2021232355794966] * [Calculation_2021231990538241] * [Calculation_2021232103333893]' />
      </column>
      <column caption='Item Supply' datatype='real' name='[Calculation_2021232362926104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2021232360861719])' />
      </column>
      <column caption='Item Scarcity (Relative)' datatype='real' name='[Calculation_2021232363716633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1/[Calculation_2021232362926104]' />
      </column>
      <column aggregation='Sum' caption='Drop Events Expected' datatype='real' name='[Calculation_2021232370548762]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_2021232355794966] * [Calculation_2021232103333893]' />
      </column>
      <column caption='item_affinities.csv' datatype='table' hidden='true' name='[__tableau_internal_object_id__].[item_affinities.csv_E2D4285BA59340A981FF517C66C371F4]' role='measure' type='quantitative' />
