      <aliases enabled='yes' />
      <column caption='Item Path Key' datatype='string' hidden='true' name='[Calculation_2021232337788948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[item_id]&#13;&#10;+ &quot; | &quot; +&#13;&#10;[root_table_id]&#13;&#10;+ &quot; | &quot; +&#13;&#10;STR([root_pool_index])' />
      </column>
      <column caption='Is Item Leaf?' datatype='boolean' name='[Calculation_2021232345575445]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[leaf_kind] = &quot;minecraft:item&quot;' />
      </column>
      <column aggregation='Sum' caption='Path Drop Chance' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_2021232355794966]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ifnull([path_pool_share_product] * [path_random_chance_product], [path_pool_share_product])' />
      </column>
      <column caption='Value Freq Rank' datatype='real' name='[Calculation_2021232380076061]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [item_value]&#13;&#10;    WHEN &quot;common&quot; THEN 1.3&#13;&#10;    WHEN &quot;uncommon&quot; THEN 1.5&#13;&#10;    WHEN &quot;rare&quot; THEN 1&#13;&#10;    WHEN &quot;epic&quot; THEN 1.25&#13;&#10;    WHEN &quot;legendary&quot; THEN .85&#13;&#10;END' />
      </column>
      <column caption='Item Value Freq Rank' datatype='real' name='[Calculation_2021232399499309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Calculation_2021232380076061])' />
      </column>
      <column caption='Item Drop Frequency' datatype='real' name='[Calculation_2021232400007214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([drop_events_expected])' />
      </column>
      <column caption='Item Frequency Ratio' datatype='real' name='[Calculation_2021232400351279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2021232400007214] / [Calculation_2021232399499309] * 2' />
      </column>
      <column caption='Item Namespace' datatype='string' name='[Calculation_2021233130868806]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([item_id], &apos;:&apos;, 1)' />
      </column>
      <column caption='Item Name' datatype='string' name='[Calculation_2021233131151431]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([item_id], &apos;:&apos;, 2)' />
      </column>
      <column caption='Root Table Namespace' datatype='string' hidden='true' name='[Calculation_2021233131405384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([root_table_id], &apos;:&apos;, 1)' />
      </column>
      <column caption='Root Table Name' datatype='string' name='[Calculation_2021233131548745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split(&#13;&#10;  split([root_table_id], &apos;:&apos;, 2),&#13;&#10;  &apos;/&apos;,&#13;&#10;  -1&#13;&#10;)' />
      </column>
      <column caption='Structure Namespace' datatype='string' name='[Calculation_2021233131913290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([structure_id], &apos;:&apos;, 1)' />
      </column>
      <column caption='Structure Name' datatype='string' name='[Calculation_2021233132040267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([structure_id], &apos;:&apos;, 2)' />
      </column>
      <column caption='Per Item Avg Chest Chance' datatype='real' hidden='true' name='[Calculation_2021233169215565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [structure_id], [item_id (root_table_item_summary.csv)] :&#13;&#10;  AVG([at_least_one_chance])&#13;&#10;}' />
      </column>
      <column caption='Structure Loot Richness Total' datatype='real' hidden='true' name='[Calculation_2021233169473614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(MIN([Calculation_2021233169215565]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Modifier Name (GLM)' datatype='string' name='[Calculation_2121563853889536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='split([modifier_type], &apos;:&apos;, 2)' />
      </column>
      <column aggregation='Sum' caption='Expected Count (GLM)' datatype='real' name='[Calculation_2121563867299852]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL((([set_count_max (modifier_added_leaf_candidates.csv)] + [set_count_min (modifier_added_leaf_candidates.csv)]) / 2), 1)' />
      </column>
      <column caption='is Item Leaf? (GLM)' datatype='boolean' name='[Calculation_2121563870965773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[leaf_kind (modifier_added_leaf_candidates.csv)] = &quot;minecraft:item&quot;' />
      </column>
      <column caption='Path Drop Chance (GLM)' datatype='real' default-format='p0.0%' name='[Calculation_2121563876323342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([path_pool_share_product (modifier_added_leaf_candidates.csv)] * [path_random_chance_product (modifier_added_leaf_candidates.csv)], [path_pool_share_product (modifier_added_leaf_candidates.csv)])' />
      </column>
      <column datatype='string' name='[Item Function (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[item_function]' new-bin='true'>
          <bin default-name='false' value='&quot;blocks&quot;'>
            <value>&quot;block_building&quot;</value>
            <value>&quot;block_crafting&quot;</value>
            <value>&quot;block_material&quot;</value>
            <value>&quot;block_misc_use&quot;</value>
            <value>&quot;block_storage&quot;</value>
            <value>&quot;block_technical&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;equipment&quot;'>
            <value>&quot;gather_tool&quot;</value>
            <value>&quot;misc_tool&quot;</value>
            <value>&quot;weapon&quot;</value>
            <value>&quot;wearable&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;items&quot;'>
            <value>&quot;consumable&quot;</value>
            <value>&quot;garden&quot;</value>
            <value>&quot;item_material&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;nonloot&quot;'>
            <value>&quot;nonloot&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Value Class Rating' datatype='integer' name='[Value Freq Rank (copy)_2730418199031816]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [item_value]&#13;&#10;    WHEN &quot;common&quot; THEN 1&#13;&#10;    WHEN &quot;uncommon&quot; THEN 2&#13;&#10;    WHEN &quot;rare&quot; THEN 3&#13;&#10;    WHEN &quot;epic&quot; THEN 4&#13;&#10;    WHEN &quot;legendary&quot; THEN 5&#13;&#10;END' />
      </column>
