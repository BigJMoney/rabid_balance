      <aliases enabled='yes' />
      <column caption='Set Count Average' datatype='real' name='[Calculation_2021231990538241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((([set_count_max] + [set_count_min]) / 2), 1)' />
      </column>
      <column caption='Table Role' datatype='string' name='[Calculation_2021232011026434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [effective_role]=&apos;assumed_direct_for_tableau&apos; or&#13;&#10;   [effective_role]=&apos;direct_from_data&apos;&#13;&#10;  then &apos;direct&apos; &#13;&#10;  else &apos;helper&apos;&#13;&#10;end' />
      </column>
      <column caption='path_loot_weight' datatype='integer' name='[Calculation_2021232073302019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([path_explicit_weight_product], 1)' />
      </column>
      <column caption='path_loot_rarity' datatype='real' name='[Calculation_2021232074440708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2021232073302019] * [Calculation_2021232103333893]' />
      </column>
      <column caption='Expected Pool Rolls' datatype='real' name='[Calculation_2021232103333893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [rolls_kind] = &apos;literal&apos;&#13;&#10;  then [rolls_min]&#13;&#10;else&#13;&#10;  ([rolls_min] + [rolls_max]) / 2&#13;&#10;end' />
      </column>
      <column caption='Total Pool Roll Exposure' datatype='real' name='[Calculation_2021232115163142]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([Calculation_2021232103333893])' />
      </column>
      <column caption='Item Loot Score' datatype='real' name='[Calculation_2021232312512519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2021232074440708])' />
      </column>
